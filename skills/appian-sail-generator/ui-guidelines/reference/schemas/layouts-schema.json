    "a!tabLayout": {
      "category": "layout",
      "description": "Displays content organized into a set of selectable tabs. Use a!tabItem() to define each tab. By default ALL tab contents evaluate on page load; defer heavy tabs with a!tabItem(loadBehavior: \"ON_TAB_SELECT\") (26.6+) or async loading. Cannot be used inside a!gridField, a!gridLayout, or a!sideBySideLayout.",
      "inherits": [],
      "parameters": {
        "tabs": {
          "type": "List of TabItem",
          "description": "Tabs to display, as a list of a!tabItem().",
          "required": true
        },
        "showWhen": {
          "type": "Boolean",
          "default": true
        },
        "marginAbove": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "NONE"
        },
        "marginBelow": {
          "type": "Text",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "STANDARD"
        },
        "highlightColor": {
          "type": "Text",
          "description": "Highlight color of the selected tab. Valid: hex (with optional transparency 00-FF) or 'ACCENT' (default).",
          "validValues": [
            "ACCENT"
          ],
          "default": "ACCENT",
          "acceptsHexColors": true,
          "supportsTransparency": true
        },
        "contentsPadding": {
          "type": "Text",
          "description": "Space between tab edges and contents.",
          "validValues": [
            "NONE",
            "EVEN_LESS",
            "LESS",
            "STANDARD",
            "MORE",
            "EVEN_MORE"
          ],
          "default": "STANDARD"
        },
        "selectedTab": {
          "type": "Text or Integer",
          "introducedIn": "26.6",
          "description": "Sets/tracks the active tab by index (starting at 1) or by a!tabItem id. Use a variable; pair with a URL-parameter rule input for shareable tab links. When null, the first visible tab is active."
        },
        "selectedTabSaveInto": {
          "type": "Save Array",
          "introducedIn": "26.6",
          "description": "Variables updated with the active tab's index or id when the user changes tabs."
        }
      },
      "specialNote": "Cannot be nested inside a!sideBySideLayout, editable grids (a!gridLayout), or read-only grids (a!gridField). The tab layout and tab items are transparent — they use the color of their container. Input errors block submission; error icon appears next to the tab label, and a validation icon appears on the navigation arrow when the errored tab isn't visible.",
      "documentationUrl": "https://docs.appian.com/suite/help/latest/Tab_Layout.html"
    },
    "a!tabItem": {
      "category": "layout",
      "description": "Displays the components and layouts of a single tab within a!tabLayout. Use only inside a!tabLayout.tabs.",
      "inherits": [],
      "parameters": {
        "label": {
          "type": "Text",
          "description": "Text displayed as the tab title.",
          "required": true
        },
        "icon": {
          "type": "Text",
          "description": "Optional icon displayed next to the label. Use any valid icon key (validate via rich-text-icon-aliases.md)."
        },
        "contents": {
          "type": "Any Type",
          "description": "Components and layouts to display when the tab is selected."
        },
        "showWhen": {
          "type": "Boolean",
          "default": true
        },
        "validations": {
          "type": "List of Variant",
          "description": "Validation errors (text array or a!validationMessage()). Display above contents of the active tab and as an icon next to the tab title."
        },
        "validationGroup": {
          "type": "Text",
          "description": "Keyword for validation group. No spaces."
        },
        "id": {
          "type": "Text",
          "introducedIn": "26.6",
          "description": "Stable identifier for use with tabLayout.selectedTab. Must be unique; if any tab has an id, ALL tabs need one. REQUIRED when tabs are shown/hidden dynamically with showWhen (indexes shift)."
        },
        "loadBehavior": {
          "type": "Text",
          "validValues": [
            "ON_LOAD",
            "ON_TAB_SELECT"
          ],
          "default": "ON_LOAD",
          "introducedIn": "26.6",
          "description": "ON_TAB_SELECT defers evaluation until the tab becomes active (good for expensive queries) BUT field validations inside are skipped until the user opens the tab - never use it on tabs containing validated inputs. Contents are cached until a reevaluation."
        }
      },
      "documentationUrl": "https://docs.appian.com/suite/help/latest/Tab_Item.html"
    },
    "a!headerTemplateImage": {
      "category": "layout",
      "description": "Title bar template that displays a prominent header with a background color at the top of a form or wizard. Spans the full width and includes a decorative image next to the title.",
      "inherits": [],
      "parameters": {
        "title": {
          "type": "Text",
          "description": "Text displayed as the header title.",
          "required": true
        },
        "secondaryText": {
          "type": "Text",
          "description": "Optional text displayed below the title."
        },
        "titleColor": {
          "type": "Text",
          "description": "Title text color. Valid: hex or STANDARD/ACCENT/SECONDARY.",
          "validValues": [
            "STANDARD",
            "ACCENT",
            "SECONDARY"
          ],
          "default": "STANDARD",
          "acceptsHexColors": true
        },
        "secondaryTextColor": {
          "type": "Text",
          "description": "Secondary text color. Valid: hex or STANDARD/ACCENT/SECONDARY.",
          "validValues": [
            "STANDARD",
            "ACCENT",
            "SECONDARY"
          ],
          "default": "STANDARD",
          "acceptsHexColors": true
        },
        "backgroundColor": {
          "type": "Text",
          "description": "Title bar background. Valid: hex (with optional transparency 00-FF) or ACCENT/WHITE/CHARCOAL_SCHEME/NAVY_SCHEME/PLUM_SCHEME.",
          "validValues": [
            "ACCENT",
            "WHITE",
            "CHARCOAL_SCHEME",
            "NAVY_SCHEME",
            "PLUM_SCHEME"
          ],
          "default": "ACCENT",
          "acceptsHexColors": true,
          "supportsTransparency": true
        },
        "image": {
          "type": "Any Type",
          "description": "Image next to title. Use a!webImage(), a!userImage(), or a!documentImage()."
        },
        "imageSize": {
          "type": "Text",
          "description": "Image size in the title bar.",
          "validValues": [
            "SMALL_PLUS",
            "MEDIUM",
            "MEDIUM_PLUS"
          ],
          "default": "SMALL_PLUS"
        }
      },
      "specialNote": "Use only inside a!formLayout(titleBar) or a!wizardLayout(titleBar). Image is hidden on smaller screens (responsive). Compatible with Portals and Offline Mobile.",
      "documentationUrl": "https://docs.appian.com/suite/help/latest/Header_Template_Image.html"
    }
  }
}
