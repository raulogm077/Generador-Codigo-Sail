        "title": {
          "type": "Any Type",
          "description": "Plain text or components shown above the chat."
        },
        "helpTooltip": {
          "type": "Text",
          "description": "Only shows when title is plain text."
        },
        "messages": {
          "type": "Any Type",
          "description": "a!chatMessage() or list of a!chatMessage()."
        },
        "height": {
          "validValues": [
            "EXTRA_SHORT",
            "SHORT",
            "SHORT_PLUS",
            "MEDIUM",
            "MEDIUM_PLUS",
            "TALL",
            "TALL_PLUS",
            "EXTRA_TALL",
            "AUTO"
          ],
          "default": "AUTO"
        },
        "shape": {
          "validValues": [
