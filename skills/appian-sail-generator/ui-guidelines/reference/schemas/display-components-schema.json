    "a!kpiField": {
      "category": "display",
      "introducedIn": "25.x",
      "description": "Native KPI component. RECORDS-ONLY: data takes a record type reference or a!recordData() - it cannot render local! mockup data. In mockups keep the card-based KPI pattern (ui-guidelines/patterns/kpis.md) with a /* TODO-CONVERTER: replace with a!kpiField */ comment; in functional (Phase 2) interfaces PREFER a!kpiField over manual card KPIs. Measures via a!measure() support their own filters - one a!kpiField replaces a whole aggregation query + card.",
      "parameters": {
        "data": {
          "type": "Any Type",
          "required": true,
          "description": "Record type reference or a!recordData(). No local! data."
        },
        "primaryMeasure": {
